{
  "manifest_version": 3,
  "name": "Nerd Buddy",
  "version": "0.1.0",
  "description": "P2P collaborative study rooms that form automatically when you're solving the same problem",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "activeTab",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.leetcode.com/*",
    "*://*.neetcode.io/*",
    "*://*.codeforces.com/*",
    "*://*.hackerrank.com/*",
    "*://*.codechef.com/*",
    "*://*.geeksforgeeks.org/*",
    "*://*.youtube.com/*",
    "*://*.arxiv.org/*",
    "*://*.github.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Nerd Buddy"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.neetcode.io/*",
        "*://*.codeforces.com/*",
        "*://*.hackerrank.com/*",
        "*://*.codechef.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://*.youtube.com/*",
        "*://*.arxiv.org/*",
        "*://*.github.com/*"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
